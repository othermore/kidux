#!/usr/bin/python3
"""One module made of web pages, for a child: `kidux-webapp <module id>`.

    kidux-webapp <module id>            open it
    kidux-webapp --print <module id>    print Chromium's command line instead

The launcher runs this, in the module's scope, for a module whose manifest
says `launch = { webapp = "<name>" }`, an application kidux-webapps serves,
or `launch = { web = "https://…" }`, a website on the internet (D85;
launcher.md section 5). It opens Chromium on that address as an
application window (`--app`): no tabs, no address bar, one window, which
the launcher keeps on its workspace above the bar (D43). Not `--kiosk`,
which hides Chromium's own bars only while the window is fullscreen, and
the launcher gives no window the whole screen.

Every module's Chromium is walled in by a proxy that answers nothing,
`--proxy-server=127.0.0.1:1`, with a bypass list of the server and the
hosts the module's manifest names: everything else fails. The managed
policy, /etc/chromium/policies/managed/kidux.json, which
kidux-chromium-policy writes from the installed modules, allows the server
and those hosts and nothing else, whatever starts Chromium (D36, D85).
Chromium's profile is the module's own, under its XDG_CONFIG_HOME, which
stays when the module is removed (D89).

After Kidux's own flags come the machine's, from /etc/kidux/chromium-flags,
which the daemon writes from the panel's Advanced settings (D51, D52), so
that a flag there wins over Kidux's for the same thing: what draws cleanly
on this machine's graphics. A line that is not a flag is left out and said.
"""

import os
import shlex
import sys
from urllib.parse import urlencode

from kidux import modules, paths

CHROMIUM = "/usr/bin/chromium"
SERVER = "http://127.0.0.1:8123"


def language(environ) -> str:
    """The child's language, from the session's locale: es_ES.UTF-8 is es."""
    for name in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = environ.get(name, "")
        if value and value not in ("C", "POSIX") and not value.startswith("C."):
            return value.split(".")[0].split("_")[0] or "en"
    return "en"


def machine_flags(path=None) -> list[str]:
    """The machine's own flags for Chromium, one a line; none when the file
    is not there."""
    try:
        lines = (path or paths.CHROMIUM_FLAGS).read_text().splitlines()
    except OSError:
        return []
    flags = []
    for line in (line.strip() for line in lines):
        if line.startswith("--"):
            flags.append(line)
        elif line:
            print(f"not a flag, left out: {line!r}", file=sys.stderr)
    return flags


def bypass(module: modules.Module) -> str:
    """The proxy's bypass list: the server, then each host of the module and
    every name under it."""
    return ";".join(["127.0.0.1", *(f"{host};*.{host}" for host in module.hosts)])


def settings(environ) -> dict[str, str]:
    """What an adult set in the module for this child (D90), as the
    launcher put it in the environment: KIDUX_SETTING_TYPE_IN=0 is type_in."""
    found = {}
    for name, value in environ.items():
        key = name[len("KIDUX_SETTING_"):].lower() if name.startswith("KIDUX_SETTING_") else ""
        if modules.SETTING_KEY.match(key):
            found[key] = value
    return dict(sorted(found.items()))


def address(module: modules.Module, lang: str, environ=None) -> str:
    """Where Chromium opens: the server's application, with the child's
    language and the module's settings, or the website, with {lang} the
    child's language."""
    if isinstance(module.launch.get("webapp"), str):
        query = urlencode({"lang": lang, **settings(environ or {})})
        return f"{SERVER}/{module.launch['webapp']}/?{query}"
    if modules.web_host(module.launch):
        return module.launch["web"].replace("{lang}", lang)
    raise ValueError(f"module {module.id} is neither a web application nor a website")


def argv(module: modules.Module, environ, flags=()) -> list[str]:
    """Chromium's command line for `module`, the machine's `flags` after
    Kidux's own; ValueError for a module that is not made of web pages."""
    lang = language(environ)
    url = address(module, lang, environ)
    config = environ.get("XDG_CONFIG_HOME") or os.path.join(environ.get("HOME", ""), ".config")
    command = [
        CHROMIUM,
        "--ozone-platform=wayland",
        "--no-first-run",
        "--no-default-browser-check",
        "--disable-session-crashed-bubble",
        "--password-store=basic",
    ]
    if "webapp" in module.launch:
        # WebGL drawn in software where the machine has no graphics Chromium
        # takes, as a virtual machine or an old computer's: Scratch's stage
        # and TurboWarp's need WebGL, and Chromium no longer falls back to
        # SwiftShader by itself. It is "unsafe" for pages from anywhere, so
        # only the server's own applications get it (D85).
        command.append("--enable-unsafe-swiftshader")
    return [
        *command,
        # The wall: a proxy that answers nothing, and only the module's own
        # hosts past it.
        "--proxy-server=127.0.0.1:1",
        f"--proxy-bypass-list={bypass(module)}",
        f"--user-data-dir={config}/chromium",
        f"--lang={lang}",
        f"--app={url}",
        *flags,
    ]


def main(args: list[str]) -> int:
    printing = args[1:2] == ["--print"]
    if len(args) != (3 if printing else 2):
        print("usage: kidux-webapp [--print] <module id>", file=sys.stderr)
        return 2
    module = modules.read(args[-1]) if modules.ID.match(args[-1] or "") else None
    if module is None:
        print(f"not an installed module: {args[-1]!r}", file=sys.stderr)
        return 2
    try:
        command = argv(module, os.environ, machine_flags())
    except ValueError as error:
        print(error, file=sys.stderr)
        return 2
    if printing:
        print(shlex.join(command))
        return 0
    os.execv(command[0], command)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
