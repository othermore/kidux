+/* Blends a label onto the keyboard by its own alpha, pixel by pixel, so */
+/* that what is drawn is the letter alone, whatever the two surfaces'    */
+/* formats: a plain blit of one surface with alpha onto another draws    */
+/* the label's box with it.                                              */
+static void blend_label(SDL_Surface* label, SDL_Surface* keyboard, int left, int top)
+{
+  int x, y;
+  Uint8 r, g, b, a, kr, kg, kb, ka;
+  Uint32 (*get_label)(SDL_Surface*, int, int) = getpixels[label->format->BytesPerPixel];
+  Uint32 (*get_key)(SDL_Surface*, int, int) = getpixels[keyboard->format->BytesPerPixel];
+  void (*put_key)(SDL_Surface*, int, int, Uint32) = putpixels[keyboard->format->BytesPerPixel];
+
+  SDL_LockSurface(label);
+  SDL_LockSurface(keyboard);
+  for (y = 0; y < label->h; y++)
+  {
+    for (x = 0; x < label->w; x++)
+    {
+      int kx = left + x, ky = top + y;
+      if (kx < 0 || ky < 0 || kx >= keyboard->w || ky >= keyboard->h)
+        continue;
+      SDL_GetRGBA(get_label(label, x, y), label->format, &r, &g, &b, &a);
+      if (a == 0)
+        continue;
+      SDL_GetRGBA(get_key(keyboard, kx, ky), keyboard->format, &kr, &kg, &kb, &ka);
+      kr = (r * a + kr * (255 - a)) / 255;
+      kg = (g * a + kg * (255 - a)) / 255;
+      kb = (b * a + kb * (255 - a)) / 255;
+      put_key(keyboard, kx, ky, SDL_MapRGBA(keyboard->format, kr, kg, kb, ka > a ? ka : a));
+    }
+  }
+  SDL_UnlockSurface(keyboard);
+  SDL_UnlockSurface(label);
+}
