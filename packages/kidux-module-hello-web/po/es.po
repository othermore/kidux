msgid "[Test] Hello on the web"
msgstr "[Prueba] Hola en la web"

msgid "The first page again, as a web page, with a link that stays closed."
msgstr ""
"Otra vez la primera página, como página web, con un enlace que sigue cerrado."

msgid "Done"
msgstr "Hecho"

msgid "Save"
msgstr "Guardar"

msgid "hello"
msgstr "hola"

msgid "A page on the internet"
msgstr "Una página de internet"

msgid ""
"This page lives on this computer. The rest of the internet stays closed."
msgstr ""
"Esta página vive en este ordenador. El resto de internet sigue cerrado."
