<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE StepCoreXML>
<world xmlns="http://edu.kde.org/step/StepCoreXML" version="1.0" id="1">
    <name>world1</name>
    <color>#ffffffff</color>
    <time>0</time>
    <timeScale>1</timeScale>
    <errorsCalculation>false</errorsCalculation>

    <item class="Box" id="2">
        <name>box</name>
        <color>#ffdce7e6</color>
        <position>(0,-2)</position>
        <angle>0</angle>
        <velocity>(0,0)</velocity>
        <angularVelocity>0</angularVelocity>
        <mass>1000</mass>
        <inertia>5354.1667</inertia>
        <size>(8,0.5)</size>
    </item>

    <item class="Anchor" id="3">
        <name>anchor</name>
        <color>#ff3b2f2a</color>
        <body>2</body>
        <position>(0,-2)</position>
        <angle>0</angle>
    </item>

    <item class="Disk" id="4">
        <name>disk</name>
        <color>#ffe4572e</color>
        <position>(0,2)</position>
        <angle>0</angle>
        <velocity>(1,0)</velocity>
        <angularVelocity>0</angularVelocity>
        <mass>1</mass>
        <inertia>0.045</inertia>
        <radius>0.3</radius>
    </item>

    <item class="WeightForce" id="5">
        <name>weightForce1</name>
        <color>#ff000000</color>
        <weightConst>9.80665</weightConst>
        <weightConstVariance>1e-10</weightConstVariance>
    </item>

    <item class="Note" id="6">
        <name>note1</name>
        <color>#ff3b2f2a</color>
        <position>(-4,4)</position>
        <size>(220,70)</size>
        <text>&lt;html&gt;&lt;body&gt;&lt;p&gt;Press Simulate. The disk bounces on the box. Add a second disk and let them crash.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text>
    </item>

    <solver class="AdaptiveEulerSolver" id="7">
        <name>solver1</name>
        <stepSize>1</stepSize>
        <toleranceAbs>0.001</toleranceAbs>
        <toleranceRel>0.001</toleranceRel>
    </solver>

    <collisionSolver class="GJKCollisionSolver" id="8">
        <name>collisionSolver1</name>
        <toleranceAbs>0.001</toleranceAbs>
    </collisionSolver>

    <constraintSolver class="CGConstraintSolver" id="9">
        <name>constraintSolver1</name>
    </constraintSolver>

</world>
