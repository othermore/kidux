<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE StepCoreXML>
<world xmlns="http://edu.kde.org/step/StepCoreXML" version="1.0" id="1">
    <name>world1</name>
    <color>#ffffffff</color>
    <time>0</time>
    <timeScale>1</timeScale>
    <errorsCalculation>false</errorsCalculation>

    <item class="Particle" id="2">
        <name>ball1</name>
        <color>#ffe4572e</color>
        <position>(-1,0)</position>
        <velocity>(0,0)</velocity>
        <mass>1</mass>
    </item>

    <item class="Particle" id="3">
        <name>ball2</name>
        <color>#ffe4572e</color>
        <position>(1,0)</position>
        <velocity>(0,0)</velocity>
        <mass>1</mass>
    </item>

    <item class="Spring" id="4">
        <name>spring1</name>
        <color>#ff3a86ff</color>
        <restLength>1</restLength>
        <stiffness>5</stiffness>
        <damping>0</damping>
        <body1>2</body1>
        <body2>3</body2>
        <localPosition1>(0,0)</localPosition1>
        <localPosition2>(0,0)</localPosition2>
    </item>

    <item class="Note" id="5">
        <name>note1</name>
        <color>#ff3b2f2a</color>
        <position>(-2.5,2)</position>
        <size>(220,70)</size>
        <text>&lt;html&gt;&lt;body&gt;&lt;p&gt;The spring is stretched. Press Simulate and watch. Then make it stiffer: stiffness 50.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text>
    </item>

    <solver class="AdaptiveEulerSolver" id="6">
        <name>solver1</name>
        <stepSize>1</stepSize>
        <toleranceAbs>0.001</toleranceAbs>
        <toleranceRel>0.001</toleranceRel>
    </solver>

    <collisionSolver class="GJKCollisionSolver" id="7">
        <name>collisionSolver1</name>
        <toleranceAbs>0.001</toleranceAbs>
    </collisionSolver>

    <constraintSolver class="CGConstraintSolver" id="8">
        <name>constraintSolver1</name>
    </constraintSolver>

</world>
