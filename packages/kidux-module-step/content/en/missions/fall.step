<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE StepCoreXML>
<world xmlns="http://edu.kde.org/step/StepCoreXML" version="1.0" id="1">
    <name>world1</name>
    <color>#ffffffff</color>
    <time>0</time>
    <timeScale>1</timeScale>
    <errorsCalculation>false</errorsCalculation>

    <item class="Particle" id="2">
        <name>ball</name>
        <color>#ffe4572e</color>
        <position>(0,3)</position>
        <velocity>(0,0)</velocity>
        <mass>1</mass>
    </item>

    <item class="WeightForce" id="3">
        <name>weightForce1</name>
        <color>#ff000000</color>
        <weightConst>9.80665</weightConst>
        <weightConstVariance>1e-10</weightConstVariance>
    </item>

    <item class="Note" id="4">
        <name>note1</name>
        <color>#ff3b2f2a</color>
        <position>(-4,4)</position>
        <size>(200,60)</size>
        <text>&lt;html&gt;&lt;body&gt;&lt;p&gt;Press Simulate. Then give the ball a sideways push: set its velocity to (2, 0).&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</text>
    </item>

    <solver class="AdaptiveEulerSolver" id="5">
        <name>solver1</name>
        <stepSize>1</stepSize>
        <toleranceAbs>0.001</toleranceAbs>
        <toleranceRel>0.001</toleranceRel>
    </solver>

    <collisionSolver class="GJKCollisionSolver" id="6">
        <name>collisionSolver1</name>
        <toleranceAbs>0.001</toleranceAbs>
    </collisionSolver>

    <constraintSolver class="CGConstraintSolver" id="7">
        <name>constraintSolver1</name>
    </constraintSolver>

</world>
