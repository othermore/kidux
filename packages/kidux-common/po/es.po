msgstr "Olvidada. Este ordenador ya no se conecta a ella por su cuenta."

#: packages/kidux-greeter/kidux_greeter/words.py:242
#, python-brace-format
msgid ""
"Forget {name}? This computer will leave it now, and not join it again by "
"itself."
msgstr ""
"¿Olvidar {name}? Este ordenador la dejará ahora y no volverá a conectarse a "
"ella por su cuenta."

#: packages/kidux-greeter/kidux_greeter/words.py:244
msgid "The network is busy. Try again in a moment."
msgstr "La red está ocupada. Prueba otra vez dentro de un momento."

