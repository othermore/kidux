#!/usr/bin/make -f

export PYBUILD_NAME=kidux
export PYBUILD_TEST_PYTEST=1

%:
	dh $@ --with python3 --buildsystem=pybuild

# The catalogues are compiled here rather than by setuptools: gettext is a
# build tool, not a Python dependency, and nothing at run time should need it.
override_dh_auto_build:
	dh_auto_build
	set -e; for po in po/*.po; do \
		lang=$$(basename $$po .po); \
		mkdir -p debian/locale/$$lang/LC_MESSAGES; \
		msgfmt --check --statistics -o debian/locale/$$lang/LC_MESSAGES/kidux.mo $$po; \
	done

# pybuild runs the tests from a copy that holds the Python package and the
# tests but not the data beside them, so the tests are told where the source
# tree is rather than left to guess.
override_dh_auto_test:
	pyflakes3 kidux tests
	KIDUX_SOURCE_ROOT=$(CURDIR) dh_auto_test

override_dh_auto_clean:
	dh_auto_clean
	rm -rf debian/locale
