#!/usr/bin/make -f

DEST = debian/kidux-module-gmail
MODULE = $(DEST)/usr/share/kidux/modules/gmail

%:
	dh $@

override_dh_auto_build:
	for po in po/*.po; do \
	    lang=$$(basename $$po .po); \
	    mkdir -p build/$$lang; \
	    msgfmt --check --output-file=build/$$lang/kidux-module-gmail.mo $$po; \
	done

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	pyflakes3 tests
	python3 -m pytest -q -p no:cacheprovider tests
endif

# The manifest, the icon and the words: the website is Google's, on the
# internet, and nothing of it is in the package.
override_dh_auto_install:
	install -D -m 0644 module.toml $(MODULE)/module.toml
	install -D -m 0644 icon.svg $(MODULE)/icon.svg
	for mo in build/*/kidux-module-gmail.mo; do \
	    lang=$$(basename $$(dirname $$mo)); \
	    install -D -m 0644 $$mo $(DEST)/usr/share/locale/$$lang/LC_MESSAGES/kidux-module-gmail.mo; \
	done

override_dh_auto_clean:
	rm -rf build tests/__pycache__
