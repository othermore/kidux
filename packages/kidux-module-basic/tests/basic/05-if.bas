10 A = 5
20 IF A = 5 THEN PRINT "EQUAL"
30 IF A < 3 THEN PRINT "LESS"
40 IF A > 3 THEN PRINT "MORE"
50 IF A <= 5 THEN PRINT "LE"
60 IF A >= 6 THEN PRINT "GE"
70 IF A <> 4 THEN PRINT "NOT FOUR"
80 IF A = 5 THEN 100
90 PRINT "SKIPPED"
100 IF A = 1 THEN PRINT "ONE" ELSE PRINT "NOT ONE"
110 N$ = "PEP"
120 IF N$ = "PEP" THEN PRINT "HI PEP"
