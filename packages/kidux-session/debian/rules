#!/usr/bin/make -f

DEST = debian/kidux-session

%:
	dh $@

override_dh_auto_install:
	install -D -m 0644 conf/greetd.toml $(DEST)/usr/share/kidux/greetd.toml
	for configuration in kiosk desk; do \
	    for file in rc.xml menu.xml themerc-override; do \
	        install -D -m 0644 conf/labwc/$$configuration/$$file \
	            $(DEST)/usr/share/kidux/labwc/$$configuration/$$file; \
	    done; \
	done
	install -D -m 0644 conf/greetd-kidux.conf $(DEST)/usr/lib/systemd/system/greetd.service.d/kidux.conf
	install -D -m 0644 conf/getty-kidux.conf $(DEST)/usr/lib/systemd/system/getty@.service.d/kidux.conf
	install -D -m 0644 conf/kidux-locker@.service $(DEST)/usr/lib/systemd/system/kidux-locker@.service
	install -D -m 0644 conf/logind.conf $(DEST)/usr/lib/systemd/logind.conf.d/kidux.conf
	install -D -m 0644 conf/sysctl.conf $(DEST)/usr/lib/sysctl.d/60-kidux.conf
	install -D -m 0644 conf/sshd.conf $(DEST)/etc/ssh/sshd_config.d/kidux.conf
	install -D -m 0644 conf/40-kidux-children.rules $(DEST)/usr/share/polkit-1/rules.d/40-kidux-children.rules
	install -D -m 0644 conf/70-kidux-switches.rules $(DEST)/usr/lib/udev/rules.d/70-kidux-switches.rules
	install -D -m 0644 conf/91-kidux-keyboard-light.rules $(DEST)/usr/lib/udev/rules.d/91-kidux-keyboard-light.rules
	install -D -m 0644 conf/pam-kidux-locker $(DEST)/etc/pam.d/kidux-locker
	install -D -m 0644 conf/90_kidux.gschema.override $(DEST)/usr/share/glib-2.0/schemas/90_kidux.gschema.override
	install -D -m 0644 grub/90-kidux.cfg $(DEST)/etc/default/grub.d/90-kidux.cfg
	install -D -m 0755 grub/09_kidux $(DEST)/etc/grub.d/09_kidux
	install -D -m 0755 bin/kidux-session $(DEST)/usr/libexec/kidux-session
	install -D -m 0755 lib/session-inner $(DEST)/usr/lib/kidux/session-inner
	install -D -m 0755 lib/greeter-session $(DEST)/usr/lib/kidux/greeter-session
	install -D -m 0755 lib/labwc-rc $(DEST)/usr/lib/kidux/labwc-rc
	install -D -m 0755 bin/kidux-lid-watch $(DEST)/usr/lib/kidux/kidux-lid-watch
	install -D -m 0755 bin/kidux-idle $(DEST)/usr/lib/kidux/kidux-idle
	install -D -m 0644 plymouth/kidux.plymouth $(DEST)/usr/share/plymouth/themes/kidux/kidux.plymouth
	install -D -m 0644 plymouth/kidux.script $(DEST)/usr/share/plymouth/themes/kidux/kidux.script
	install -D -m 0644 plymouth/logo.png $(DEST)/usr/share/plymouth/themes/kidux/logo.png
