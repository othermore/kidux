<?xml version="1.0"?>
<!--
  The compositor of a child's session with windows (session.md, section 3;
  D46, D57, D58): Kidux's own, root's and read-only to the child. Every
  window in a frame with its title, to move it by, its edges, to resize it
  by, and its buttons, iconify, maximise and close; placed in cascade. The
  launcher's window, maximised and always under every other, is the desk's
  floor. No key but the four below and a laptop's own for its screen,
  keyboard light and sound, no menu.
-->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>0</gap>
    <xwaylandPersistence>no</xwaylandPersistence>
  </core>
  <placement><policy>cascade</policy></placement>
  <theme>
    <titlebar>
      <layout>icon:iconify,max,close</layout>
      <showTitle>yes</showTitle>
    </titlebar>
    <cornerRadius>0</cornerRadius>
    <font place="ActiveWindow"><name>Andika</name><size>13</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>Andika</name><size>13</size><weight>bold</weight></font>
  </theme>
  <windowSwitcher show="no" preview="no" outlines="no" />
  <keyboard>
    <!-- Super is the bar's Home: the launcher shows the desk, every window
         minimised, and remembers them to bring them back. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="pkill -USR1 -f &quot;^/usr/bin/python3 /usr/libexec/kidux-launcher&quot;" />
    </keybind>
    <keybind key="A-F4">
      <action name="Execute" command="pkill -USR2 -f &quot;^/usr/bin/python3 /usr/libexec/kidux-launcher&quot;" />
    </keybind>
    <!-- Alt+Tab goes round the windows with the launcher (D64): the bar
         lights the one it points at, and Alt let go goes there. -->
    <keybind key="A-Tab">
      <action name="Execute" command="pkill -RTMIN+1 -f &quot;^/usr/bin/python3 /usr/libexec/kidux-launcher&quot;" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="Execute" command="pkill -RTMIN+2 -f &quot;^/usr/bin/python3 /usr/libexec/kidux-launcher&quot;" />
    </keybind>
    <!-- A laptop's keys for the screen, the keyboard's light and the sound,
         the same keysyms on a Mac and on a PC (D61, docs/dev/keys.md):
         kidux-keys does the thing, as the child. -->
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="/usr/libexec/kidux-keys brightness up" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="/usr/libexec/kidux-keys brightness down" /></keybind>
    <keybind key="XF86KbdBrightnessUp"><action name="Execute" command="/usr/libexec/kidux-keys keyboard up" /></keybind>
    <keybind key="XF86KbdBrightnessDown"><action name="Execute" command="/usr/libexec/kidux-keys keyboard down" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="/usr/libexec/kidux-keys volume up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="/usr/libexec/kidux-keys volume down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="/usr/libexec/kidux-keys volume mute" /></keybind>
  </keyboard>
  <mouse>
    <!-- Never a plain press on the Frame context: labwc swallows a press a
         Frame binding matches, and the program under it would never get a
         click (labwc-notes.md). TitleBar and Client cover the window. -->
    <context name="TitleBar">
      <mousebind button="Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
    </context>
    <context name="Top"><mousebind button="Left" action="Drag"><action name="Resize" /></mousebind></context>
    <context name="Left"><mousebind button="Left" action="Drag"><action name="Resize" /></mousebind></context>
    <context name="Right"><mousebind button="Left" action="Drag"><action name="Resize" /></mousebind></context>
    <context name="Bottom"><mousebind button="Left" action="Drag"><action name="Resize" /></mousebind></context>
    <context name="TLCorner"><mousebind button="Left" action="Drag"><action name="Resize" /></mousebind></context>
    <context name="TRCorner"><mousebind button="Left" action="Drag"><action name="Resize" /></mousebind></context>
    <context name="BLCorner"><mousebind button="Left" action="Drag"><action name="Resize" /></mousebind></context>
    <context name="BRCorner"><mousebind button="Left" action="Drag"><action name="Resize" /></mousebind></context>
    <context name="Title">
      <mousebind button="Left" action="Drag"><action name="Move" /></mousebind>
      <mousebind button="Left" action="DoubleClick"><action name="ToggleMaximize" /></mousebind>
    </context>
    <context name="Iconify">
      <mousebind button="Left" action="Click"><action name="Iconify" /></mousebind>
    </context>
    <context name="Maximize">
      <mousebind button="Left" action="Click"><action name="ToggleMaximize" /></mousebind>
    </context>
    <context name="Close">
      <mousebind button="Left" action="Click"><action name="Close" /></mousebind>
    </context>
    <context name="Client">
      <mousebind button="Left" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="Middle" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
      <mousebind button="Right" action="Press"><action name="Focus" /><action name="Raise" /></mousebind>
    </context>
  </mouse>
  <windowRules>
    <windowRule identifier="org.kidux.Launcher" serverDecoration="no">
      <action name="Maximize" />
      <action name="ToggleAlwaysOnBottom" />
    </windowRule>
  </windowRules>
</labwc_config>
