#!/usr/bin/python3
"""labwc's rc.xml for a child's session, on standard output: Kidux's own,
with the pointer's speed and the touchpad's scroll an adult set on the
panel's Advanced page (kidux.pointer; docs/dev/session.md, section 3).

    labwc-rc <Kidux's rc.xml>

What the panel set is /etc/kidux/input.xml, which the daemon writes; without
it, or when it says anything else, the middle steps.
"""

import sys
from pathlib import Path

from kidux import paths, pointer


def main(args: list[str]) -> int:
    if len(args) != 2:
        print("usage: labwc-rc <rc.xml>", file=sys.stderr)
        return 2
    try:
        sys.stdout.write(pointer.rc_xml(Path(args[1]).read_text(encoding="utf-8"),
                                        paths.INPUT_XML))
    except (OSError, ValueError) as error:
        print(f"labwc-rc: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
