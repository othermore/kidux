#!/usr/bin/make -f

DEST = debian/kidux-module-kig
MODULE = $(DEST)/usr/share/kidux/modules/kig

%:
	dh $@

override_dh_auto_build:
	for po in po/*.po; do \
	    lang=$$(basename $$po .po); \
	    mkdir -p build/$$lang; \
	    msgfmt --check --output-file=build/$$lang/kidux-module-kig.mo $$po; \
	done

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	pyflakes3 tests
	sh -n bin/kidux-module-kig
	python3 -m pytest -q -p no:cacheprovider tests
endif

override_dh_auto_install:
	install -D -m 0644 module.toml $(MODULE)/module.toml
	install -D -m 0644 icon.svg $(MODULE)/icon.svg
	install -D -m 0644 kde/kdeglobals $(MODULE)/kde/kdeglobals
	cp -r content $(MODULE)/content
	find $(MODULE)/content -type d -exec chmod 0755 {} +
	find $(MODULE)/content -type f -exec chmod 0644 {} +
	install -D -m 0755 bin/kidux-module-kig $(DEST)/usr/libexec/kidux-module-kig
	for mo in build/*/kidux-module-kig.mo; do \
	    lang=$$(basename $$(dirname $$mo)); \
	    install -D -m 0644 $$mo $(DEST)/usr/share/locale/$$lang/LC_MESSAGES/kidux-module-kig.mo; \
	done

override_dh_auto_clean:
	rm -rf build tests/__pycache__
