# The Kidux package archive.
#
# Kidux's own packages come from here. The archive is signed: apt verifies the
# signature on the Release file, and the Signed-By line below means it accepts
# nothing that the Kidux key did not sign.
#
# "stable" holds the packages that have been tested on a real machine. It is
# what a family's computer follows, and where its updates come from.
Types: deb
URIs: https://kidux.org/apt
Suites: stable
Components: main
Signed-By: /usr/share/keyrings/kidux-archive-keyring.pgp
