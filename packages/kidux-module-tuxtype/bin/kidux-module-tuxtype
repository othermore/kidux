#!/bin/sh
# Tux Typing, as a child's learning module.
#
# Tux Typing takes its menus' language from the session, and its words, the
# ones that fall, and its lessons from a theme it is given. Kidux brings a
# theme of its own for each language it has lessons in, kidux-<language>
# (lessons/build.py): the words of Tux Typing's theme for that language, and
# Kidux's lessons. A child whose language has none gets English's. It starts in a window, --window, rather than asking for the
# whole screen: the compositor gives it the room above the bar either way,
# and labwc gives a window taken out of fullscreen a title bar (modules.md,
# section 2). It draws through XWayland, not through the Wayland the session
# asks SDL for: there SDL 1.2 (sdl12-compat) scales its 640x480 pictures to
# the room it is given, while as a Wayland window it stays at 640x480 in a
# corner.
#
# Tux Typing keeps its settings and a child's scores in ~/.tuxtype. It is
# given the module's own XDG_DATA_HOME as its home, which the launcher makes
# for it (modules.md, section 2), so that they are the module's alone, and
# the child's home is left as the child keeps it.

set -eu

unset SDL_VIDEODRIVER

THEMES="${KIDUX_TUXTYPE_THEMES:-/usr/share/tuxtype/themes}"
language="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
language="${language%%_*}"
language="${language%%.*}"
theme="kidux-$language"
if [ -z "$language" ] || [ ! -d "$THEMES/$theme" ]; then
    theme="kidux-en"
fi

if [ -n "${XDG_DATA_HOME:-}" ]; then
    mkdir -p "$XDG_DATA_HOME"
    HOME="$XDG_DATA_HOME"
    export HOME
fi

exec /usr/games/tuxtype --window --theme "$theme"
