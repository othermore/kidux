#!/usr/bin/make -f

export PYBUILD_NAME=kidux-launcher
export PYBUILD_TEST_PYTEST=1

%:
	dh $@ --with python3 --buildsystem=pybuild

# The foreign-toplevel protocol's Python, made from its XML (protocol/).
override_dh_auto_configure:
	python3 protocol/generate.py kidux_launcher/protocol
	dh_auto_configure

override_dh_auto_clean:
	rm -rf kidux_launcher/protocol
	dh_auto_clean

override_dh_auto_test:
	pyflakes3 kidux_launcher/*.py tests
	dh_auto_test
