<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CodeCombat</title>
<style>
  :root { --cream: #fff6e9; --ink: #3b2f2a; --sun: #f0a202; --wrong: #7a3310; }
  html, body { height: 100%; margin: 0; }
  body { display: flex; flex-direction: column; align-items: center; justify-content: center;
         gap: 28px; background: var(--cream); color: var(--ink);
         font: 24px/1.5 "Andika", sans-serif; text-align: center; padding: 32px;
         box-sizing: border-box; }
  .mascot { width: 140px; height: 140px; }
  #said { max-width: 36em; }
  #said.wrong { color: var(--wrong); }
  .waiting::after { content: ""; display: block; width: 36px; height: 36px; margin: 24px auto 0;
                    border: 5px solid #e8dccb; border-top-color: var(--sun); border-radius: 50%;
                    animation: turn 1s linear infinite; }
  @keyframes turn { to { transform: rotate(360deg); } }
  button { font: inherit; font-weight: bold; padding: 12px 28px; border: 0; border-radius: 14px;
           background: var(--sun); color: var(--ink); cursor: pointer; }
  button:focus-visible { outline: 4px solid #3584e4; outline-offset: 2px; }
</style>
</head>
<body>
 <!-- Kidux mascot: a penguin chick, after Tux. Flat shapes, no gradients, no strokes thinner than 4 units, so it reads at 32 px and at a metre wide. The colours are the brand palette in branding/README.md. --> <svg class="mascot" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200" role="img" aria-label="Kidux mascot"> <!-- feet, under the body --> <ellipse cx="80" cy="184" rx="21" ry="9" fill="#f0a202"/> <ellipse cx="120" cy="184" rx="21" ry="9" fill="#f0a202"/> <!-- flippers --> <ellipse cx="27" cy="128" rx="13" ry="34" transform="rotate(24 27 128)" fill="#2f4157"/> <ellipse cx="173" cy="128" rx="13" ry="34" transform="rotate(-24 173 128)" fill="#2f4157"/> <!-- body --> <path d="M100 26 C150 26 170 78 170 120 C170 158 140 184 100 184 C60 184 30 158 30 120 C30 78 50 26 100 26 Z" fill="#24313f"/> <!-- the white front: face and belly in one --> <path d="M100 54 C128 54 146 78 148 114 C150 150 132 176 100 176 C68 176 50 150 52 114 C54 78 72 54 100 54 Z" fill="#fdf6f0"/> <!-- tuft --> <path d="M90 30 C88 20 82 15 76 14" fill="none" stroke="#24313f" stroke-width="6" stroke-linecap="round"/> <path d="M100 26 C100 17 100 12 100 8" fill="none" stroke="#24313f" stroke-width="6" stroke-linecap="round"/> <path d="M110 30 C112 20 118 15 124 14" fill="none" stroke="#24313f" stroke-width="6" stroke-linecap="round"/> <!-- cheeks --> <circle cx="70" cy="104" r="7" fill="#f6d7c4"/> <circle cx="130" cy="104" r="7" fill="#f6d7c4"/> <!-- eyes --> <circle cx="84" cy="86" r="9" fill="#2b2b2b"/> <circle cx="116" cy="86" r="9" fill="#2b2b2b"/> <circle cx="87" cy="83" r="3" fill="#fdf6f0"/> <circle cx="119" cy="83" r="3" fill="#fdf6f0"/> <!-- beak --> <path d="M100 96 L86 104 L100 116 L114 104 Z" fill="#f0a202"/> </svg> 
<p id="said" class="waiting"></p>
<button type="button" id="again" hidden></button>
<script>
  // The words of every language, written in when the package is built.
  const WORDS = @WORDS@;
  const asked = new URLSearchParams(window.location.search).get("lang") || "en";
  const words = WORDS[asked] || WORDS.en;
  document.documentElement.lang = WORDS[asked] ? asked : "en";
  const said = document.getElementById("said");
  const again = document.getElementById("again");
  // What kidux-webapp tells the page: "connecting", "refused",
  // "unreachable" or "notset"; the button asks it to sign in once more,
  // or, with no account set, to go to the site's own sign-in page.
  window.kidux = {
    show(state) {
      said.textContent = words[state] || words.unreachable;
      said.className = state === "connecting" ? "waiting" : state === "notset" ? "" : "wrong";
      again.textContent = state === "notset" ? words.byhand : words.again;
      again.dataset.asks = state === "notset" ? "manual" : "";
      again.hidden = state === "connecting";
      if (!again.hidden) { again.focus(); }
    },
  };
  again.addEventListener("click", () => {
    const asks = again.dataset.asks;
    window.kidux.show("connecting");
    if (window.kiduxTryAgain) { window.kiduxTryAgain(asks); }
  });
  window.kidux.show("connecting");
</script>
</body>
</html>
