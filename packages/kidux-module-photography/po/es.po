msgid "Photography"
msgstr "Fotografía"

msgid ""
"A guide to taking photographs with a real camera: light, the shutter, the "
"aperture, focus, composition, and drawing with light, with something to try "
"in every chapter."
msgstr "Una guía para hacer fotos con una cámara de verdad: la luz, el obturador, el diafragma, el enfoque, la composición y dibujar con luz, con algo que probar en cada capítulo."

msgid "Back"
msgstr "Atrás"

msgid "Next"
msgstr "Siguiente"

msgid "Chapters"
msgstr "Capítulos"

msgid "Try it"
msgstr "Pruébalo"

#, python-brace-format
msgid "On the {camera}"
msgstr "En la {camera}"

msgid ""
"Other cameras have the same thing under other names; chapter 3 says how to "
"find it."
msgstr "Otras cámaras tienen lo mismo con otros nombres; el capítulo 3 explica cómo encontrarlo."

msgid "For the adult"
msgstr "Para el adulto"

#, python-brace-format
msgid "Photo: {author}, {licence}"
msgstr "Foto: {author}, {licence}"

msgid "Photo: Kidux"
msgstr "Foto: Kidux"

msgid "Picture made by a computer"
msgstr "Imagen hecha por un ordenador"

msgid "public domain"
msgstr "dominio público"
